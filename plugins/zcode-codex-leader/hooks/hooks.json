{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" session-start",
            "timeout": 30,
            "statusMessage": "Starting codex app-server worker and injecting leader constitution"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" pre-tool-use",
            "timeout": 5,
            "statusMessage": "Leader gate: checking tool use"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" user-prompt-submit",
            "timeout": 5,
            "statusMessage": "Leader gate: annotating prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" stop",
            "timeout": 10,
            "statusMessage": "Evidence gate: checking Plugin evidence"
          }
        ]
      }
    ]
  }
}
